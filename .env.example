# ==============================================================================
# Offline School ERP System - Environment Configuration Template
# Copy this file to .env and configure with your secure offline production values
# DO NOT COMMIT THE REAL .env FILE TO PUBLIC REPOSITORIES
# ==============================================================================

# Database Connection (SQLite Local File)
DATABASE_URL="file:./dev.db"

# 256-bit AES Master Encryption Key for Field-Level Data Protection (64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-hex-encoded-secret-encryption-key-goes-here-000000000"

# Director Security Master PIN / Key for Maker-Checker Approvals & Clearances
DIRECTOR_MASTER_KEY="your-secure-master-pin-here"

# Session Security & Anti-Tamper Secret
SESSION_SECRET="your-strong-random-session-secret-here"

# Application Base URL for Anti-Tamper QR Verification Codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server Port
PORT=3000
